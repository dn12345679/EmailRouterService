{
  "name": "email-router-test",
  "version": "1.0.1",
  "description": "records emails",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.emailrouter",
    "productName": "Email Router",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.env",
      "!token_cache.json",
      "!auth-record.json",
      "!*.token",
      "!CSV{,/**}",
      "!ARCHITECTURE.md"
    ],
    "extraFiles": [
      { "from": "config/config.external.example.js", "to": "config.example.js" },
      { "from": ".env.example", "to": ".env.example" },
      { "from": "propertyToRegion.json", "to": "propertyToRegion.example.json" }
    ],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@azure/identity": "^4.13.1",
    "@azure/identity-cache-persistence": "^1.3.0",
    "@azure/msal-node-extensions": "^5.3.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "isomorphic-fetch": "^3.0.0",
    "pg": "^8.22.0",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  }
}
